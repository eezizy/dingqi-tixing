# ===== 管理页登录锁（不设 AUTH_USER 则任何人都能进管理页，务必设置）=====
AUTH_USER=admin
AUTH_PASS=改成你自己的强密码

# ===== 推送凭证（也可在前端「⚙ 设置」里填；前端填写优先于这里）=====
# 企业微信（自建应用）
WX_CORPID=                      # 企业微信后台「我的企业 → 企业信息」最下方「企业ID」（ww 开头）
WX_CORPSECRET=                 # 自建应用的 Secret
WX_AGENTID=                    # 自建应用 AgentId
WX_TOUSER=                     # 接收人 UserID（通讯录里你自己的账号）

# Resend 邮件
RESEND_API_KEY=                # Resend 控制台 API Keys 复制的 re_xxx 那串
EMAIL_FROM=                    # 已验证域名下的发件地址（如 oncall@yourdomain.com）
EMAIL_TO=                      # 实际收信邮箱（如 Gmail）

# 时区（用于计算触发时刻）
TZ=Asia/Shanghai

# 服务端口（1Panel 建站时做端口映射用）
PORT=8080
